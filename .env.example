# Copy this file to .env and fill in what you have. Every key is optional:
# with no keys at all, the agent falls back to your local Ollama model.

# https://aistudio.google.com/apikey  (free tier: Flash / Flash-Lite models)
GEMINI_API_KEY=

# https://console.groq.com/keys  (free tier, very fast, ~6-8K tokens/minute)
GROQ_API_KEY=

# https://github.com/settings/tokens  (no scopes needed; raises GitHub limits
# from 60 to 5000 requests/hour and makes the repo search far more reliable)
GITHUB_TOKEN=
